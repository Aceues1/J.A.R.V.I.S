# Copy this file to .env and fill in your own key.
# .env is gitignored — never commit real credentials.

# Required. Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Speech-to-text model for voice input. Defaults to whisper-large-v3-turbo.
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- Voice output (text-to-speech) ----
# Without any extra keys, voice output uses Groq PlayAI on your GROQ_API_KEY.
# For a higher-quality cinematic voice, get a key at https://elevenlabs.io
# and set it here — ElevenLabs is then preferred automatically.
# ELEVENLABS_API_KEY=

# Optional. Force a provider: elevenlabs | groq | off. Default: auto-select.
# TTS_PROVIDER=

# Optional. ElevenLabs voice + model overrides. The default voice is "Daniel",
# a stock British voice with a composed, precise, assistant-like delivery.
# Browse https://elevenlabs.io/app/voice-library for alternatives.
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional. Delivery tuning, both 0..1. Higher stability = calmer, more even
# delivery; lower = more expressive. Defaults: 0.62 / 0.8.
# ELEVENLABS_STABILITY=0.62
# ELEVENLABS_SIMILARITY=0.8

# Optional. Groq PlayAI voice override. Defaults to Basil-PlayAI.
# GROQ_TTS_VOICE=Basil-PlayAI

# ---- Awareness ----
# Optional. Your current/home location, set explicitly (never inferred or
# tracked). "Sistranda"/"Frøya" and "Trondheim" get live weather for
# "what's the weather here?"; other values are kept but have no live weather.
# JARVIS_LOCATION=Sistranda

# Optional. Path to your work-schedule file. Defaults to jarvis.schedule.json
# in the project folder. See jarvis.schedule.example.json for the format.
# JARVIS_SCHEDULE_PATH=

# ---- Live web search (PRO 3) ----
# The baseline layered search (DuckDuckGo HTML → TechCrunch RSS for AI news,
# plus wttr.in weather / Yahoo Finance prices / Instagram followers) needs NO
# key. Optional: a Brave Search API key enables the Brave fallback layer when
# DuckDuckGo returns nothing. Get one at https://brave.com/search/api
# BRAVE_SEARCH_API_KEY=

# Optional. Model for the fast search-gate decision call.
# Defaults to openai/gpt-oss-20b.
# GROQ_GATE_MODEL=openai/gpt-oss-20b

# Optional. Set to 1 to run a per-source web-search self-test at startup:
# DuckDuckGo, Brave (if keyed), Yahoo Finance, wttr.in, TechCrunch, and the
# search gate each print PASS/FAIL to the terminal. Diagnostics only.
# JARVIS_WEBSEARCH_DEBUG=1
