# Copy this file to .env and fill in your own key.
# .env is gitignored — never commit real credentials.

# Required. Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Speech-to-text model for voice input. Defaults to whisper-large-v3-turbo.
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- Voice output (text-to-speech) ----
# Without any extra keys, voice output uses Groq PlayAI on your GROQ_API_KEY.
# For a higher-quality cinematic voice, get a key at https://elevenlabs.io
# and set it here — ElevenLabs is then preferred automatically.
# ELEVENLABS_API_KEY=

# Optional. Force a provider: elevenlabs | groq | off. Default: auto-select.
# TTS_PROVIDER=

# Optional. ElevenLabs voice + model overrides. The default voice is "Daniel",
# a stock British voice with a composed, precise, assistant-like delivery.
# Browse https://elevenlabs.io/app/voice-library for alternatives.
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional. Delivery tuning, both 0..1. Higher stability = calmer, more even
# delivery; lower = more expressive. Defaults: 0.62 / 0.8.
# ELEVENLABS_STABILITY=0.62
# ELEVENLABS_SIMILARITY=0.8

# Optional. Groq PlayAI voice override. Defaults to Basil-PlayAI.
# GROQ_TTS_VOICE=Basil-PlayAI
