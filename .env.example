# Copy this file to .env and fill in your own key.
# .env is gitignored — never commit real credentials.

# Required. Get a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Speech-to-text model for voice input. Defaults to whisper-large-v3-turbo.
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional. Client-side tokens-per-minute budget for main chat requests.
# Defaults to 7200, just under the 8000 TPM free-tier limit; requests that
# would exceed it wait for the rolling 60s window instead of hitting 429.
# GROQ_TPM_BUDGET=7200

# ---- Free AI provider fallback (main chat only) ----
# When Groq's daily/minute quota is exhausted, JARVIS automatically fails
# over: Groq -> OpenRouter free gpt-oss-120b (same model, same behavior) ->
# Gemini free Flash. Exhausted providers rest for exactly the window their
# Retry-After advertised, then are probed again — no restart needed. Tiers
# without a key are simply skipped. Legitimate documented free tiers only.
#
# OpenRouter: free key at https://openrouter.ai/keys — then enable the
# "Free model publication" setting at https://openrouter.ai/settings/privacy
# or free models return 404. Free tier: ~50 requests/day. The default model
# "openrouter/free" is OpenRouter's own router over whatever free models are
# currently live (specific ":free" slugs get delisted without notice); pin
# OPENROUTER_MODEL to a specific slug if you prefer one.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
#
# Gemini: free key at https://aistudio.google.com/apikey (no card). Both the
# old AIza... and new AQ.... key formats work — JARVIS authenticates with
# Google's native x-goog-api-key header.
# PRIVACY: Google may train on free-tier prompts, so JARVIS never sends your
# persistent-memory block to Gemini — those turns just lose personalization.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# ---- Voice output (text-to-speech) ----
# Without any extra keys, voice output uses Groq PlayAI on your GROQ_API_KEY.
# For a higher-quality cinematic voice, get a key at https://elevenlabs.io
# and set it here — ElevenLabs is then preferred automatically.
# ELEVENLABS_API_KEY=

# Local voice (Kokoro): free, offline after a one-time ~92MB model download,
# CPU-only so the GPU stays free for games. Set LOCAL_TTS=on to enable — it
# then takes priority, and cloud TTS is only used while the model is still
# loading or if it fails. No API key needed.
# LOCAL_TTS=on

# Optional local voice tuning. Voice defaults to bm_george (British male);
# other British options: bm_lewis, bm_daniel, bm_fable. Dtype q8 (~92MB) is
# the recommended balance; fp32 is bigger and slower on CPU for little gain.
# Model files cache under the app's userData folder unless KOKORO_CACHE_DIR
# points elsewhere.
# LOCAL_TTS_VOICE=bm_george
# LOCAL_TTS_DTYPE=q8
# KOKORO_CACHE_DIR=

# Optional. Force a provider: local | elevenlabs | groq | off.
# Default: auto-select (local when LOCAL_TTS=on, then ElevenLabs, then Groq).
# TTS_PROVIDER=

# Optional. ElevenLabs voice + model overrides. The default voice is "Daniel",
# a stock British voice with a composed, precise, assistant-like delivery.
# Browse https://elevenlabs.io/app/voice-library for alternatives.
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Optional. Delivery tuning, both 0..1. Higher stability = calmer, more even
# delivery; lower = more expressive. Defaults: 0.62 / 0.8.
# ELEVENLABS_STABILITY=0.62
# ELEVENLABS_SIMILARITY=0.8

# Optional. Groq PlayAI voice override. Defaults to Basil-PlayAI.
# GROQ_TTS_VOICE=Basil-PlayAI

# ---- Awareness ----
# Optional. Your current/home location, set explicitly (never inferred or
# tracked). "Sistranda"/"Frøya" and "Trondheim" get live weather for
# "what's the weather here?"; other values are kept but have no live weather.
# JARVIS_LOCATION=Sistranda

# Optional. Path to your work-schedule file. Defaults to jarvis.schedule.json
# in the project folder. See jarvis.schedule.example.json for the format.
# JARVIS_SCHEDULE_PATH=

# ---- Live web search (PRO 3) ----
# The baseline layered search (DuckDuckGo HTML → TechCrunch RSS for AI news,
# plus wttr.in weather / Yahoo Finance prices / Instagram followers) needs NO
# key. Optional: a Brave Search API key enables the Brave fallback layer when
# DuckDuckGo returns nothing. Get one at https://brave.com/search/api
# BRAVE_SEARCH_API_KEY=

# Optional. Model for the fast search-gate decision call.
# Defaults to openai/gpt-oss-20b.
# GROQ_GATE_MODEL=openai/gpt-oss-20b

# Optional. Set to 1 to run a per-source web-search self-test at startup:
# DuckDuckGo, Brave (if keyed), Yahoo Finance, wttr.in, TechCrunch, and the
# search gate each print PASS/FAIL to the terminal. Diagnostics only.
# JARVIS_WEBSEARCH_DEBUG=1

# ---- Persistent memory (PRO 4) ----
# Memories are stored locally in <userData>/jarvis-memory.json and never
# leave this machine (only relevant snippets are included in AI requests).
# Optional overrides:
# JARVIS_MEMORY_PATH=            # alternate memory file location
# GROQ_MEMORY_MODEL=openai/gpt-oss-20b   # model for memory curation calls

# ---- Spotify (PRO 5) ----
# Create an app at https://developer.spotify.com/dashboard and add
#   http://127.0.0.1:8888/callback
# as a Redirect URI. Both values stay in the Electron MAIN process only.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional. Pin the Groq TTS model. Unset, JARVIS tries the known model and,
# if Groq has decommissioned it, discovers a live TTS model automatically
# from the account's model list. Pair with GROQ_TTS_VOICE for non-PlayAI models.
# GROQ_TTS_MODEL=
