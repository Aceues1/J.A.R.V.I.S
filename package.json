{
  "name": "jarvis-gui",
  "version": "0.2.0",
  "description": "JARVIS desktop command-center interface",
  "main": "./out/main/index.js",
  "author": "aceues1",
  "homepage": "https://github.com/aceues1/J.A.R.V.I.S",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "ensure-electron": "node scripts/ensure-electron.js",
    "verify-electron-zip": "node scripts/verify-electron-zip.js",
    "predev": "node scripts/ensure-electron.js",
    "prestart": "node scripts/ensure-electron.js",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "node scripts/ensure-electron.js && electron-builder install-app-deps",
    "prebuild:unpack": "node scripts/ensure-electron.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "prebuild:win": "node scripts/ensure-electron.js",
    "build:win": "npm run build && electron-builder --win",
    "prebuild:mac": "node scripts/ensure-electron.js",
    "build:mac": "electron-vite build && electron-builder --mac",
    "prebuild:linux": "node scripts/ensure-electron.js",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "dotenv": "^17.4.2",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "postcss": "^8.5.26",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
